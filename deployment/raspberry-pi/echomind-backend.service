[Unit]
Description=EchoMind Python Backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=__PI_USER__
WorkingDirectory=__REPO_DIR__
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-__REPO_DIR__/.env
ExecStart=__REPO_DIR__/.venv/bin/python -u __REPO_DIR__/main.py
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
