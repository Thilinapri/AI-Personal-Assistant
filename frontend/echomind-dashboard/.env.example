# EchoMind Next.js Server-Side Environment Variables
# Used strictly on the server-side by Next.js API routes / proxies.
# Do NOT prefix with NEXT_PUBLIC_ to prevent browser exposure.
ECHOMIND_API_URL=http://127.0.0.1:5000
# EchoMind Flask backend
# Server-side only.
ECHOMIND_API_URL=http://127.0.0.1:5000

# Supabase cloud reminder storage
# Server-side only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Use a Supabase secret key.
# NEVER prefix this with NEXT_PUBLIC_.
# NEVER commit the real value.
SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY

# Shared token used by an EchoMind device when synchronizing reminders.
# Generate a long random value for each deployment.
ECHOMIND_DEVICE_SYNC_TOKEN=YOUR_RANDOM_DEVICE_TOKEN